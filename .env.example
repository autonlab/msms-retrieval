# Copy to .env (git-ignored) and fill in. Variables already set in the environment take precedence.

# MassSpecGym 1.5: the spectra TSV and the directory holding the two retrieval-candidate JSONs
SNA_MSG_TSV=/path/to/MassSpecGym1.5.tsv
SNA_MSG_CANDIDATES=/path/to/candidates

# Optional: simulated-spectra store (GLACIER + FraGNNet), prepared with --sim
SNA_AUTONMOL=/path/to/simulated_store

# Pretrained spectrum-encoder checkpoints
SNA_CKPT_DREAMS_SSL=/path/to/dreams_ssl.ckpt
SNA_CKPT_DREAMS_CONTRASTIVE=/path/to/dreams_contrastive.ckpt
SNA_CKPT_DREAMS_VF=/path/to/dreams_vf.ckpt
SNA_CKPT_DREAMS_VF_CONTROL=/path/to/dreams_vf_control.ckpt
SNA_CKPT_MSJEPA=/path/to/msjepa.ckpt
SNA_CKPT_MSJEPA_GEOM_BASE=/path/to/msjepa_geom_base.ckpt
SNA_CKPT_MSJEPA_GEOM_MCOS=/path/to/msjepa_geom_mcos.ckpt
SNA_CKPT_MSJEPA_GEOM_VF=/path/to/msjepa_geom_vf.ckpt

# Output root: prep/ (caches) and runs/ (one directory per experiment)
SNA_OUT=/path/to/output

# GPUs for training (comma-separated CUDA indices in PCI bus order); JESTR uses the first
SNA_GPUS=0,1,2,3
